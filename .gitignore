# .gitignore

# Environment Configuration (Contains sensitive API Keys)
.env

# Python specific cache and bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
ENV/

# OS generated files
.DS_Store
Thumbs.db

# Local logs (Optional: upload your test logs, but ignore future noise)
# If you want to keep the logs directory empty on GitHub but track the folder:
# logs/*
# !logs/bot.log
